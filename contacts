<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Контакты - Социалистический портал</title>
    <link rel="stylesheet" href="style.css">
    <style>
        /* ---------- СТИЛИ ДЛЯ КОНТАКТОВ ---------- */
        .contacts-content {
            padding: 60px 0;
            background: #8B0000;
        }

        .contacts-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 45px;
            max-width: 1050px;
            margin: 0 auto;
        }

        .contact-info {
            background: linear-gradient(145deg, #5C0000, #4A0000);
            padding: 35px;
            border-radius: 16px;
            border: 2px solid #FFD700;
            box-shadow: 0 6px 25px rgba(0,0,0,0.5);
        }

        .contact-info p {
            font-size: 1.15rem;
            color: #FFF8DC;
            margin-bottom: 30px;
            line-height: 1.9;
        }

        .contact-details {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 14px 18px;
            background: rgba(255,215,0,0.05);
            border-radius: 8px;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .contact-item:hover {
            background: rgba(255,215,0,0.1);
            transform: translateX(8px);
            border-color: rgba(255,215,0,0.2);
        }

        .contact-icon {
            font-size: 1.8rem;
            min-width: 45px;
        }

        /* ---------- ФОРМА ---------- */
        .contact-form {
            background: linear-gradient(145deg, #5C0000, #4A0000);
            padding: 35px;
            border-radius: 16px;
            border: 2px solid #FFD700;
            box-shadow: 0 6px 25px rgba(0,0,0,0.5);
        }

        .contact-form h3 {
            color: #FFD700;
            font-size: 2rem;
            margin-bottom: 25px;
            text-align: center;
            letter-spacing: 2px;
        }

        .contact-form form {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .contact-form input,
        .contact-form textarea {
            padding: 14px 18px;
            background: rgba(255,255,255,0.08);
            border: 2px solid #FFD700;
            border-radius: 8px;
            color: #FFF8DC;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            outline: none;
            background: rgba(255,255,255,0.12);
            border-color: #FFF8DC;
            box-shadow: 0 0 20px rgba(255,215,0,0.15);
        }

        .contact-form input::placeholder,
        .contact-form textarea::placeholder {
            color: #B8860B;
        }

        .btn-submit {
            padding: 16px;
            background: linear-gradient(135deg, #FFD700, #DAA520);
            color: #5C0000;
            border: none;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .btn-submit:hover {
            background: linear-gradient(135deg, #FFF8DC, #FFD700);
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(255,215,0,0.3);
        }

        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* ---------- УВЕДОМЛЕНИЯ ---------- */
        .form-message {
            display: none;
            padding: 15px 20px;
            border-radius: 8px;
            text-align: center;
            font-size: 1rem;
            margin-top: 15px;
            animation: slideDown 0.5s ease;
        }

        .form-message.show {
            display: block;
        }

        .form-message.success {
            background: rgba(107, 255, 107, 0.1);
            border: 2px solid #6BFF6B;
            color: #6BFF6B;
        }

        .form-message.error {
            background: rgba(255, 107, 107, 0.1);
            border: 2px solid #FF6B6B;
            color: #FF6B6B;
        }

        .form-message.loading {
            background: rgba(107, 181, 255, 0.1);
            border: 2px solid #6BB5FF;
            color: #6BB5FF;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ---------- SPINNER ДЛЯ ЗАГРУЗКИ ---------- */
        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
            vertical-align: middle;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .contacts-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .contact-form,
            .contact-info {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <nav>
        <div class="nav-container">
            <a href="index.html" class="logo">☭ Официальный сайт КП НРТК(и)</a>
            <ul class="nav-links">
                <li><a href="index.html">Главная</a></li>
                <li><a href="news.html">Новости</a></li>
                <li><a href="history.html">История</a></li>
                <li><a href="contacts.html" class="active">Контакты</a></li>
            </ul>
        </div>
    </nav>

    <main>
        <section class="page-header">
            <div class="container">
                <h1>📬 Контакты</h1>
                <div class="divider"></div>
            </div>
        </section>

        <section class="contacts-content">
            <div class="container">
                <div class="contacts-grid">
                    <!-- Контактная информация -->
                    <div class="contact-info">
                        <p>
                            <!-- ВСТАВЬТЕ СВОЙ ТЕКСТ ЗДЕСЬ -->
                            Свяжитесь с нами любым удобным способом. Мы всегда рады помочь!
                        </p>
                        
                        <div class="contact-details">
                            <div class="contact-item">
                                <span class="contact-icon">📧</span>
                                <span>Email: alex10kuz@gmail.com</span>
                            </div>
                            <div class="contact-item">
                                <span class="contact-icon">📞</span>
                                <span>Телефон: +7 (953) 568-22-20</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- ФОРМА ОБРАТНОЙ СВЯЗИ -->
                    <div class="contact-form">
                        <h3>✉️ Напишите нам</h3>
                        
                        <!-- 
                            ═══════════════════════════════════════════
                            ВАШ ЭНДПОИНТ ОТ FORMSUBMIT
                            ═══════════════════════════════════════════
                        -->
                        <form id="contactForm" 
                              action="https://formsubmit.co/el/yaseso" 
                              method="POST"
                              onsubmit="return handleSubmit(event)">
                            
                            <!-- Скрытые настройки FormSubmit -->
                            <input type="hidden" name="_captcha" value="false">
                            <input type="hidden" name="_template" value="table">
                            <input type="hidden" name="_next" value="https://your-site.com/thanks.html">
                            
                            <!-- Поля формы -->
                            <input type="text" name="name" placeholder="👤 Ваше имя" required>
                            <input type="email" name="email" placeholder="📧 Ваш Email" required>
                            <input type="text" name="subject" placeholder="📌 Тема сообщения" required>
                            <textarea name="message" rows="4" placeholder="📝 Ваше сообщение..." required></textarea>
                            
                            <button type="submit" class="btn-submit" id="submitBtn">
                                📤 Отправить сообщение
                            </button>
                        </form>
                        
                        <!-- Сообщения об успехе/ошибке -->
                        <div id="formMessage" class="form-message"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <p>© 2026 ЦК КП НРТК. Все права защищены.</p>
    </footer>

    <script>
        // ==============================================
        // ОБРАБОТКА ОТПРАВКИ ФОРМЫ
        // ==============================================
        
        async function handleSubmit(e) {
            e.preventDefault();
            
            const form = document.getElementById('contactForm');
            const submitBtn = document.getElementById('submitBtn');
            const messageDiv = document.getElementById('formMessage');
            
            // Получаем данные формы
            const formData = new FormData(form);
            
            // Показываем загрузку
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner"></span> Отправка...';
            
            messageDiv.className = 'form-message loading show';
            messageDiv.textContent = '⏳ Отправка сообщения...';
            
            try {
                // Отправляем запрос на ваш эндпоинт
                const response = await fetch('https://formsubmit.co/el/yaseso', {
                    method: 'POST',
                    body: formData
                });
                
                // FormSubmit возвращает HTML-страницу, проверяем статус
                if (response.ok) {
                    // Успешно отправлено
                    messageDiv.className = 'form-message success show';
                    messageDiv.innerHTML = `
                        ✅ <strong>Спасибо!</strong> Ваше сообщение отправлено.<br>
                        <small style="opacity: 0.7;">Мы свяжемся с вами в ближайшее время.</small>
                    `;
                    
                    // Очищаем форму
                    form.reset();
                    
                    // Скрываем сообщение через 5 секунд
                    setTimeout(() => {
                        messageDiv.className = 'form-message';
                    }, 5000);
                } else {
                    throw new Error('Ошибка отправки: ' + response.status);
                }
                
            } catch (error) {
                // Ошибка
                messageDiv.className = 'form-message error show';
                messageDiv.innerHTML = `
                    ❌ <strong>Ошибка!</strong> Не удалось отправить сообщение.<br>
                    <small style="opacity: 0.7;">Пожалуйста, попробуйте позже или напишите нам на почту напрямую.</small>
                `;
                
                console.error('Ошибка отправки:', error);
            } finally {
                // Восстанавливаем кнопку
                submitBtn.disabled = false;
                submitBtn.innerHTML = '📤 Отправить сообщение';
            }
        }

        // ==============================================
        // АЛЬТЕРНАТИВНЫЙ ВАРИАНТ (если fetch не работает)
        // ==============================================
        
        // Если форма не отправляется через fetch, используйте этот вариант:
        /*
        function handleSubmit(e) {
            // Форма отправится обычным способом через action
            // Показываем сообщение об успехе
            const messageDiv = document.getElementById('formMessage');
            messageDiv.className = 'form-message success show';
            messageDiv.innerHTML = `
                ✅ <strong>Спасибо!</strong> Ваше сообщение отправлено.<br>
                <small style="opacity: 0.7;">Мы свяжемся с вами в ближайшее время.</small>
            `;
            
            setTimeout(() => {
                messageDiv.className = 'form-message';
            }, 5000);
            
            return true; // Разрешаем отправку
        }
        */
    </script>
</body>
</html>
